@startuml
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title C4 Container. Доставка через Temporal

System_Ext(bank, "Сервис банковских операций", "Фиксирует операции и ведёт свой outbox")
System_Ext(events, "Kafka банка", "События о проведённых операциях")
System_Ext(profile, "Профиль клиента", "Проверенные контакты и настройки каналов")
Person(support, "Поддержка", "Проверяет судьбу уведомления")
System_Ext(app, "Приложение банка", "Показывает push и подтверждает получение")

System_Boundary(delivery, "Notification Platform / транзакционная доставка") {
    Container(api, "Входной шлюз", "Kotlin / Spring Boot", "Читает события, принимает подтверждения, отдаёт статусы")
    ContainerDb(db, "Хранилище шлюза", "PostgreSQL", "Входные события, outbox и история для поддержки")
    Container(temporal, "Сервер Temporal", "Temporal Server", "Ведёт историю workflow, таймеры и очереди задач")
    ContainerDb(history, "Хранилище Temporal", "PostgreSQL", "История и состояние workflow")
    Container(worker, "Обработчики доставки", "Kotlin / Temporal Java SDK", "Исполняют workflow и вызывают каналы. Пул выделен для транзакций")
}

System_Ext(push, "Push", "FCM / APNs")
System_Ext(sms, "SMS", "Twilio")
System_Ext(email, "Email", "Amazon SES / SNS")

Rel(bank, events, "Публикует события из outbox", "Kafka")
Rel_D(events, api, "Передаёт события с notification_id", "Kafka")
Rel(support, api, "Смотрит статус", "HTTPS")
Rel(app, api, "Подтверждает получение push", "HTTPS")
Rel(api, db, "Пишет входные события, подтверждения и статусы", "SQL")
Rel_D(api, temporal, "Запускает workflow и передаёт сигналы из outbox", "gRPC")
Rel(temporal, history, "Сохраняет историю, задачи и таймеры", "SQL")
Rel_D(temporal, worker, "Выдаёт задачи workflow и Activity", "gRPC")
Rel(worker, api, "Запрашивает право на отправку, пишет статус", "HTTPS")
Rel(worker, profile, "Читает настройки и адреса", "HTTPS")
Rel(worker, push, "Отправляет push", "HTTPS")
Rel(worker, sms, "Отправляет SMS", "HTTPS")
Rel(worker, email, "Отправляет письмо", "HTTPS")
Rel(push, app, "Передаёт push", "Push")
Rel(sms, api, "Присылает отчёт о доставке", "HTTPS")
Rel(email, api, "Присылает статус письма", "HTTPS")

SHOW_LEGEND()
@enduml
